<script setup>
import { ref, onMounted } from 'vue'
import { useI18n } from 'vue-i18n'
import { useRouter, useRoute } from 'vue-router'
import api from '@/plugins/axios'

const { t }  = useI18n()
const router = useRouter()
const route  = useRoute()

const form = ref({
    token:                '',
    email:                '',
    password:             '',
    password_confirmation: '',
})

const errors      = ref({})
const serverError = ref('')
const successMsg  = ref('')
const isLoading   = ref(false)

// Leer token y email de la URL automáticamente
onMounted(() => {
    form.value.token = route.query.token || ''
    form.value.email = route.query.email || ''
})

async function handleSubmit() {
    errors.value      = {}
    serverError.value = ''
    successMsg.value  = ''
    isLoading.value   = true

    try {
        const { data } = await api.post('/auth/reset-password', form.value)
        successMsg.value = data.message

        // Redirigir al login después de 2 segundos
        setTimeout(() => router.push({ name: 'login' }), 2000)
    } catch (err) {
        if (err.response?.status === 422) {
            const data = err.response.data
            if (data.errors) {
                errors.value = data.errors
            } else {
                serverError.value = data.message || t('auth.reset.invalid_token')
            }
        } else {
            serverError.value = t('auth.reset.generic_error')
        }
    } finally {
        isLoading.value = false
    }
}
</script>

<template>
    <div class="login-page">
        <div class="login-card">

            <h1 class="login-title">{{ t('auth.reset.title') }}</h1>
            <p class="login-subtitle">{{ t('auth.reset.subtitle') }}</p>

            <div v-if="successMsg" class="login-success">
                {{ successMsg }}
            </div>

            <div v-if="serverError" class="login-error">
                {{ serverError }}
            </div>

            <form v-if="!successMsg" class="login-form" @submit.prevent="handleSubmit" novalidate>

                <div class="form-group">
                    <label>{{ t('auth.reset.password') }}</label>
                    <input
                        v-model="form.password"
                        type="password"
                        placeholder="••••••••"
                        :style="errors.password ? 'border-color: #e24b4a' : ''"
                        autocomplete="new-password"
                    />
                    <span v-if="errors.password" style="color:#ff8a89; font-size:12px;">
                        {{ errors.password[0] }}
                    </span>
                </div>

                <div class="form-group">
                    <label>{{ t('auth.reset.password_confirm') }}</label>
                    <input
                        v-model="form.password_confirmation"
                        type="password"
                        placeholder="••••••••"
                        :style="errors.password_confirmation ? 'border-color: #e24b4a' : ''"
                        autocomplete="new-password"
                    />
                    <span v-if="errors.password_confirmation" style="color:#ff8a89; font-size:12px;">
                        {{ errors.password_confirmation[0] }}
                    </span>
                </div>

                <button type="submit" class="login-btn" :disabled="isLoading">
                    {{ isLoading ? t('auth.reset.submitting') : t('auth.reset.submit') }}
                </button>

            </form>

            <div class="login-footer">
                <a href="#" @click.prevent="router.push({ name: 'login' })">
                    ← {{ t('auth.forgot.back_to_login') }}
                </a>
            </div>
        </div>
    </div>
</template>

