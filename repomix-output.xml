<template>
    <div class="day-view">
        <AppTopbar :title="formattedDate" :crumbs="[
            { label: $t('users.crumbs.dashboard'), icon: 'fa-house', route: 'admin.dashboard' },
            { label: $t('appointments.title'), icon: 'fa-calendar-check', route: 'admin.appointments' },
